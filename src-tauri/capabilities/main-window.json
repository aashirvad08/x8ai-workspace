{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Everything the main window's webview may invoke. Each entry is an explicit grant; anything not listed is rejected by Tauri before the command runs. Keep this list minimal and review every addition.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-app-subscribe",
    "allow-app-set-unsaved-changes",
    "allow-app-quit",
    "allow-app-take-warnings",
    "allow-agent-list",
    "allow-agent-request-approval",
    "allow-agent-revoke",
    "allow-agent-create-session",
    "allow-agent-run",
    "allow-agent-sessions",
    "allow-agent-stop",
    "allow-agent-remove",
    "allow-agent-changes",
    "allow-agent-read-file",
    "allow-provider-list",
    "allow-provider-set-credential",
    "allow-provider-remove-credential",
    "allow-provider-add-model",
    "allow-provider-remove-model",
    "allow-terminal-create",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-ack",
    "allow-terminal-is-busy",
    "allow-terminal-close",
    "allow-workspace-open",
    "allow-workspace-open-recent",
    "allow-workspace-recent",
    "allow-workspace-forget-recent",
    "allow-workspace-set-trust",
    "allow-workspace-search",
    "allow-workspace-search-cancel",
    "allow-workspace-list-dir",
    "allow-workspace-read-file",
    "allow-workspace-file-version",
    "allow-workspace-write-file",
    "allow-workspace-create-file",
    "allow-workspace-create-dir",
    "allow-workspace-rename",
    "allow-workspace-delete",
    "allow-workspace-list-files"
  ]
}
