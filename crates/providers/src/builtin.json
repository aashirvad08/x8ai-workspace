    "endpoints": [
      { "api": "anthropicMessages", "baseUrl": "https://openrouter.ai/api" },
      { "api": "openAiChatCompletions", "baseUrl": "https://openrouter.ai/api/v1" }
    ],
    "auth": { "kind": "apiKey", "secret": "openrouter" }
  },
  {
    "id": "ollama",
    "name": "Ollama",
    "description": "Open models running on this machine. Nothing leaves it.",
    "hosting": "local",
    "endpoints": [
      { "api": "anthropicMessages", "baseUrl": "http://localhost:11434" },
      { "api": "openAiChatCompletions", "baseUrl": "http://localhost:11434/v1" }
