    "endpoints": [{ "api": "gemini", "baseUrl": "https://generativelanguage.googleapis.com/v1beta" }],
    "auth": { "kind": "apiKey", "secret": "google" }
  },
  {
    "id": "openrouter",
    "name": "OpenRouter",
    "description": "A gateway to many providers' models, through one API key.",
