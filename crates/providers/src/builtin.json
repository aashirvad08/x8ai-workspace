      { "id": "claude-haiku-4-5-20251001", "name": "Claude Haiku 4.5" }
    ]
  },
  {
    "id": "openai",
    "name": "OpenAI",
    "description": "OpenAI's models, through its API.",
    "hosting": "hosted",
    "endpoints": [
      { "api": "openAiResponses", "baseUrl": "https://api.openai.com/v1" },
      { "api": "openAiChatCompletions", "baseUrl": "https://api.openai.com/v1" }
    ],
    "auth": { "kind": "apiKey", "secret": "openai" }
